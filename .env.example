# --- Telegram credentials (MTProto) ---
# Get these at https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=
# Bot token from @BotFather
TG_BOT_TOKEN=

# --- AI API (router / proxy) ---
AI_BASE_URL=https://9.todict.tech/v1
AI_API_KEY=
AI_TIMEOUT=120

# --- Bot behavior ---
MAX_HISTORY=12
TG_SESSION_NAME=ai_bot
SYSTEM_PROMPT=

# --- Streaming reply throttling ---
DRAFT_UPDATE_INTERVAL=0.8

# --- Custom emoji (Telegram Premium) ---
# Requires the bot owner account to have Telegram Premium, or the bot to
# have purchased an additional username on Fragment. Set to false to send
# plain Unicode emoji instead.
ENABLE_CUSTOM_EMOJI=true
ENABLE_BUTTON_ICONS=true

# --- Pending mode-selection buttons ---
# Seconds a "Thinking / Direct" button stays valid before it expires.
PENDING_TTL=600

# --- Admin / database ---
# Telegram numeric user IDs allowed to use /gitpull, /broadcast and /stats.
# Multiple IDs: 123456789,987654321
ADMIN_IDS=
DATABASE_PATH=data/bot.db

# /gitpull settings
GIT_BRANCH=main
GIT_REPO_DIR=.
