# --- Telegram credentials (MTProto) ---
# Get these at https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=
# Bot token from @BotFather
TG_BOT_TOKEN=

# --- AI API (router / proxy) ---
AI_BASE_URL=https://9.todict.tech/v1
AI_API_KEY=
AI_TIMEOUT=120

# --- Bot behavior ---
MAX_HISTORY=12
TG_SESSION_NAME=ai_bot
SYSTEM_PROMPT=

# --- Streaming reply throttling ---
DRAFT_UPDATE_INTERVAL=0.8

# --- Pending mode-selection buttons ---
# Seconds a "Thinking / Direct" button stays valid before it expires.
PENDING_TTL=600
