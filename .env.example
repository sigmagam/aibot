# --- Telegram credentials (MTProto) ---
# Get these at https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=
# Bot token from @BotFather
TG_BOT_TOKEN=

# --- AI API (router / proxy) ---
AI_BASE_URL=https://9.todict.tech/v1
AI_API_KEY=
AI_TIMEOUT=120

# --- Bot behavior ---
MAX_HISTORY=12
TG_SESSION_NAME=ai_bot

# --- Streaming reply throttling ---
DRAFT_UPDATE_INTERVAL=0.8

# --- Custom emoji (Telegram Premium) ---
# Requires the bot owner account to have Telegram Premium, or the bot to
# have purchased an additional username on Fragment. Set to false to send
# plain Unicode emoji instead.
ENABLE_CUSTOM_EMOJI=true
ENABLE_BUTTON_ICONS=true

# --- Pending mode-selection buttons ---
# Seconds a "Thinking / Direct" button stays valid before it expires.
PENDING_TTL=600

# --- Message effect (private chats only, Kurigram's `effect_id') ---
# See: https://docs.kurigram.icu/api/methods/get_available_effects/
START_EFFECT_ID=5159385139981059251

# --- Admin / database ---
# Telegram numeric user IDs allowed to use /sh, /gitpull, /broadcast and /stats.
# Multiple IDs: 123456789,987654321
ADMIN_IDS=
DATABASE_PATH=data/bot.db

# --- Auto update from GitHub ---
# git pull --ff-only + pip install on startup. /gitpull does the same on
# demand. Pull only — the bot never commits or pushes.
GIT_AUTO_PULL=true
GIT_BRANCH=main
GIT_REPO_DIR=.

# --- VPS shell (/sh command, admin only) ---
# /sh <command> runs on the machine hosting the bot. Set ENABLE_SHELL=false
# to disable the command entirely.
ENABLE_SHELL=true
SHELL_TIMEOUT=60
SHELL_WORKDIR=/root
